# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=your_gemini_api_key

# APP_URL: The URL where this app is hosted.
APP_URL=http://localhost:3000

# Server port and environment
PORT=3000
NODE_ENV=production

# SESSION_SECRET: Cryptographic secret for signing session tokens across restarts (min 32 chars).
SESSION_SECRET=replace_with_a_long_random_secret

# Initial Platform Administrator (provisioned on first run if no admin exists)
PLATFORM_ADMIN_EMAIL=admin@teescucho.edu
PLATFORM_ADMIN_PASSWORD=change_this_strong_password

# ENABLE_DEMO_ACCESS: Set to "true" only in sandbox/demo deployments (never in production).
ENABLE_DEMO_ACCESS=false

# BREAK_GLASS_SECRET: Optional 32+ char key for AES-256-GCM encryption of voluntary emergency contacts.
BREAK_GLASS_SECRET=replace_with_a_long_random_secret

# Optional VAPID keys for Zero-PII camouflaged PWA Push notifications (auto-generated if omitted).
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@example.com

# Optional Supabase PostgreSQL persistence (recommended for production).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
